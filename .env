# network
POSTGRES_DB_HOST=user-db-postgres
POSTGRES_DB_EXTERNAL_PORT=5434
POSTGRES_DB_INTERNAL_PORT=5432
POSTGRES_DB=user-micro-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PGSSLMODE_STATUS=disable
DB_AUTO_MIGRATE=true
LOG_OUTPUT=file
LOG_DIR=logs

# healthcheck
HEALTHCHECK_INTERVAL=1s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=10

USER_HTTP=8080
GRPC_PORT=9092

# JWT
JWT_SECRET=f9Xb0gDpafz2Ns+1HwXopHSkdG2k5UQKaZHKUkeP7Dw=
JWT_ACCESS_EXPIRATION=15
JWT_REFRESH_EXPIRATION=10080

# tokens
# 5 min
ACCESS_TOKEN_LIFETIME=300000
# 5 days
REFRESH_TOKEN_LIFETIME=432000000

# code
CODE_LIFETIME_MINUTES=5
ACTUAL_CODE_PATTERN=[0-9]{6}

# clean
SESSION_CLEAN_TIME=600000
CODE_CLEAN_TIME=300000

# swagger
ENV_SWAGGER_API_VERSION=v1
ENV_SWAGGER_APP_DESCRIPTION=User API
ENV_SWAGGER_LICENSE=Apache 2.0
ENV_SWAGGER_LICENSE_URL=https://www.apache.org/licenses/LICENSE-2.0.html
ENV_SWAGGER_DEV_SERVER=http://localhost/user

#
ENV_MAX_AVATAR_SIZE=5242880
ENV_MAX_INACTIVITY_PERIOD=15552000000
ENV_MIN_INACTIVITY_PERIOD=0