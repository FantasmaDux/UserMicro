# network
POSTGRES_DB_HOST=networking-db-postgres
POSTGRES_DB_EXTERNAL_PORT=5434
POSTGRES_DB_INTERNAL_PORT=5432
POSTGRES_DB=networking-micro-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PGSSLMODE_STATUS=disable
DB_AUTO_MIGRATE=true
LOG_OUTPUT=file
LOG_DIR=logs

# healthcheck
HEALTHCHECK_INTERVAL=1s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=10

HTTP_PORT=8081
GRPC_PORT=9092